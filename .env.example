# Database - Use PostgreSQL (local or cloud)
# Local: DATABASE_URL="postgresql://user:password@localhost:5432/lifelink"
# Cloud Supabase: DATABASE_URL="postgresql://user:password@db.supabase.co:5432/postgres?schema=public"
DATABASE_URL="postgresql://postgres:password@localhost:5432/lifelink"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-a-strong-one-min-32-chars"

# Optional - Google Maps API (for map features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-api-key-here"

# Payment Gateway (Demo mode)
NEXT_PUBLIC_PAYMENT_MODE="demo"
RAZORPAY_KEY_ID="your-razorpay-key"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Admin credentials for demo
ADMIN_EMAIL="admin@lifelink.com"
ADMIN_PASSWORD="admin123"
