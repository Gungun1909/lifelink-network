// Prisma Schema for LIFELINK Healthcare Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================
model User {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  phoneNumber   String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bloodGroup    String?
  location      String?
  latitude      Float?
  longitude     Float?
  emergencyContact String?
  role          String     @default("user")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  consultations Consultation[]
  bookings      Booking[]
  bloodRequests BloodRequest[]
  savedDoctors  SavedDoctor[]
  savedHospitals SavedHospital[]
  payments      Payment[]

  @@index([email])
  @@index([phoneNumber])
}

// ==================== HOSPITAL MANAGEMENT ====================
model Hospital {
  id                String     @id @default(cuid())
  name              String
  city              String
  district          String
  address           String
  latitude          Float
  longitude         Float
  phoneNumber       String
  email             String?
  emergencyAvailable Boolean   @default(true)
  rating            Float      @default(0)
  description       String?
  image             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  departments    Department[]
  doctors        Doctor[]
  services       HospitalService[]
  prices         HospitalPrice[]
  consultations  Consultation[]
  bookings       Booking[]
  savedBy        SavedHospital[]

  @@index([city])
  @@index([district])
  @@index([latitude, longitude])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  description String?
  hospitalId String
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors   Doctor[]

  @@index([hospitalId])
}

// ==================== DOCTOR MANAGEMENT ====================
model Doctor {
  id              String     @id @default(cuid())
  name            String
  specialization  String
  qualification   String
  experience      Int
  phoneNumber     String?
  email           String?
  image           String?
  bio             String?
  consultationFee Int
  hospitalId      String
  departmentId    String?
  hospital        Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department      Department? @relation(fields: [departmentId], references: [id])
  rating          Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  availableSlots  AvailableSlot[]
  consultations   Consultation[]
  savedBy         SavedDoctor[]

  @@index([hospitalId])
  @@index([specialization])
}

model AvailableSlot {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek String
  startTime String
  endTime   String
  slotDuration Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
}

model SavedDoctor {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, doctorId])
  @@index([userId])
}

// ==================== BLOOD DONOR MANAGEMENT ====================
model BloodDonor {
  id              String     @id @default(cuid())
  donorId         String     @unique
  bloodGroup      String
  city            String
  district        String
  latitude        Float
  longitude       Float
  availability    String     @default("available")
  lastVerified    DateTime
  contactInfo     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bloodRequests   BloodRequest[]

  @@index([bloodGroup])
  @@index([city])
  @@index([district])
}

model BloodRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup String
  requiredQuantity Int
  city      String
  district  String
  reason    String?
  status    String   @default("pending")
  donorId   String?
  donor     BloodDonor? @relation(fields: [donorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bloodGroup])
}

model SavedHospital {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hospitalId])
  @@index([userId])
}

// ==================== SERVICES & PRICING ====================
model HospitalService {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices      HospitalPrice[]

  @@index([hospitalId])
}

model HospitalPrice {
  id          String   @id @default(cuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  serviceId   String
  service     HospitalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hospitalId, serviceId])
  @@index([hospitalId])
}

// ==================== CONSULTATION & BOOKING ====================
model Consultation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  appointmentDate DateTime
  reason          String
  consultationType String
  status          String   @default("scheduled")
  paymentStatus   String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment         Payment?

  @@index([userId])
  @@index([doctorId])
  @@index([hospitalId])
}

model Booking {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  serviceId       String
  serviceName     String
  bookingDate     DateTime
  status          String   @default("confirmed")
  paymentStatus   String   @default("pending")
  totalAmount     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment         Payment?

  @@index([userId])
  @@index([hospitalId])
}

// ==================== PAYMENT MANAGEMENT ====================
model Payment {
  id              String   @id @default(cuid())
  amount          Int
  paymentStatus   String   @default("pending")
  transactionReference String?
  paymentMethod   String?
  consultationId  String?  @unique
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  bookingId       String?  @unique
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ==================== ADMIN UTILITIES ====================
model CSVImportLog {
  id          String   @id @default(cuid())
  fileName    String
  entityType  String
  totalRows   Int
  successRows Int
  failureRows Int
  errors      String?
  importedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
